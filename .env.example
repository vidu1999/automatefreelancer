# Choose a strong unique password and a random 32+ character signing secret.
APP_PASSWORD=replace-with-a-strong-unique-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Server-side only. This prototype accepts localhost or the Docker service name ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
